# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Project-specific
.port
data/
.DS_Store

# Machine-specific files — local only, never part of the public tree
*.command
.claude/launch.json
.claude/settings.local*
CLAUDE.local.md
.env
.env.*
* 2.*

# Vendored tokenizer data files — re-fetchable via `python -m src.cli vendor`,
# integrity-checked against the committed SHA256SUMS.json manifest
vendor/tokenizers/*
!vendor/tokenizers/SHA256SUMS.json

# Vendored lexicon data files — re-fetchable via `python -m src.cli lexica`,
# same integrity model as tokenizers
vendor/lexica/*
!vendor/lexica/SHA256SUMS.json

# vendor/_fallback/ is deliberately TRACKED — committed last-resort copies used
# only when the network fetch fails (see src/vendor_lexica.py). Do not add a
# blanket vendor/* ignore rule, and do not add CC BY-SA sources here; only
# redistributable ones belong (NOTICE-DATA.md).
!vendor/_fallback/
